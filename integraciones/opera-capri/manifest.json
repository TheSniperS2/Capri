{
  "manifest_version": 3,
  "name": "Capri — YouTube en Opera",
  "version": "1.0.2",
  "description": "Conecta el reproductor de YouTube con Capri en este computador.",
  "key": "",
  "host_permissions": ["http://127.0.0.1/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://www.youtube.cl/*", "https://youtube.cl/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://www.youtube.cl/*", "https://youtube.cl/*"],
    "js": ["page.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }, {
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://www.youtube.cl/*", "https://youtube.cl/*"],
    "js": ["control.js", "content.js"],
    "run_at": "document_idle"
  }]
}
